{
  "name": "@octovault/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "OctoVaultAI desktop — your private AI for personal paperwork.",
  "author": {
    "name": "OctoVaultAI",
    "email": "sunil28071987@gmail.com"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:mac-arm": "electron-vite build && electron-builder --mac --arm64",
    "package:mac-x64": "electron-vite build && electron-builder --mac --x64",
    "package:mac-universal": "electron-vite build && electron-builder --mac --universal",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers"
  },
  "comment": "Runtime deps in main process need real install (native modules can't be bundled). Keep this list minimal — just the native ones. UI / renderer deps stay in devDependencies because Vite bundles them.",
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^11.7.0"
  },
  "devDependencies": {
    "@octovault/core": "0.0.1",
    "@octovault/ui": "0.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "@electron/rebuild": "^3.7.1",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
